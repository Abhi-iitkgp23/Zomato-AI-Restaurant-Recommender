# LLM — Phase 3/4 default: Groq (OpenAI-compatible)
# Get a key at https://console.groq.com — never commit real keys.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Other providers (optional): openai | gemini | ollama
# Gemini requires: pip install -e ".[gemini]"

# Data
# Absolute path or path relative to the project root
DATA_PATH=data/processed/restaurants.parquet
METADATA_PATH=data/processed/metadata.json

# Recommendation pipeline
CANDIDATE_K=15
DEFAULT_TOP_N=5

# Budget bands (approx cost for two, INR)
BUDGET_LOW_MAX=400
BUDGET_MED_MAX=800

# Optional Hugging Face dataset pin (leave empty for latest)
HF_DATASET_ID=ManikaSaini/zomato-restaurant-recommendation
HF_DATASET_REVISION=
